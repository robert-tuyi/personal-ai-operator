# Copy to .env and fill in. Never commit .env.

# Local dev defaults to SQLite (zero setup). Use the Supabase Postgres URL in prod.
DATABASE_URL=sqlite:///./dev.db

# Anthropic API (required for brief + drafts)
ANTHROPIC_API_KEY=

# Google OAuth (Gmail + Calendar). Create an OAuth 2.0 Web client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI registered on the OAuth client.
#
# Two valid setups (pick one; whatever you set here must ALSO be added in Google Console):
#   (a) Backend-direct (default below): hit the backend at :8000 directly. Simplest if you
#       are testing the API alone, but the session cookie is set on the :8000 origin.
#   (b) Frontend proxy (recommended when running the Next.js app): the frontend proxies
#       /api/* to the backend, so the browser is same-origin and the login Set-Cookie lands
#       on the frontend origin. For this, set BOTH of these to the :3000 callback/origin:
#           GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
#           APP_URL=http://localhost:3000
#       and register http://localhost:3000/api/v1/auth/callback in Google Console.
#   See ../RUNNING.md for the full walkthrough.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Signs the login session cookie. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Where the backend redirects the browser AFTER a successful login. For the frontend-proxy
# setup (b) above, set this to http://localhost:3000 so the user lands back in the app.
APP_URL=http://localhost:8000
APP_ENV=development
