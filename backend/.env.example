# Copy to .env and fill in. Never commit .env.

# Local dev defaults to SQLite (zero setup) when running the backend natively. Use the
# Supabase Postgres URL in prod. `docker compose up` overrides this automatically to point
# at the bundled Postgres+pgvector service (needed for the Phase 2 memory layer).
DATABASE_URL=sqlite:///./dev.db

# LLM provider for brief + drafts: "openai" (default) or "anthropic".
LLM_PROVIDER=openai
# OpenAI API (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Anthropic API (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Google OAuth (Gmail + Calendar). Create an OAuth 2.0 Web client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI registered on the OAuth client.
#
# Two valid setups (pick one; whatever you set here must ALSO be added in Google Console):
#   (a) Backend-direct (default below): hit the backend at :8000 directly. Simplest if you
#       are testing the API alone, but the session cookie is set on the :8000 origin.
#   (b) Frontend proxy (recommended when running the Next.js app): the frontend proxies
#       /api/* to the backend, so the browser is same-origin and the login Set-Cookie lands
#       on the frontend origin. For this, set BOTH of these to the :3000 callback/origin:
#           GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
#           APP_URL=http://localhost:3000
#       and register http://localhost:3000/api/v1/auth/callback in Google Console.
#   See ../RUNNING.md for the full walkthrough.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Signs the login session cookie. Blank/default is fine for local dev (APP_ENV=development
# below) — the app refuses to start with this insecure outside dev (ADR 0003). Generate a
# real value before any non-development deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Encrypts stored Google OAuth tokens at rest (ADR 0003). The value below is a working but
# PUBLIC, INSECURE dev-only key (same as the code default) — fine for local dev, but the app
# refuses to start with it outside dev. Generate a real one before any non-development
# deployment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=E5SCWk1BU7BjId6tUZBRXQ7cWv1NvccnH197mL0r060=

# Where the backend redirects the browser AFTER a successful login. For the frontend-proxy
# setup (b) above, set this to http://localhost:3000 so the user lands back in the app.
APP_URL=http://localhost:8000
APP_ENV=development
