# Copy to .env and fill in. Never commit .env.

# Local dev defaults to SQLite (zero setup). Use the Supabase Postgres URL in prod.
DATABASE_URL=sqlite:///./dev.db

# Anthropic API (required for brief + drafts)
ANTHROPIC_API_KEY=

# Google OAuth (Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_URL=http://localhost:8000
APP_ENV=development
